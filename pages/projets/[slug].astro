---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.locale === 'fr');
  return projects.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const formattedDate = new Date(data.date).toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={data.seoTitle || data.title}
  description={data.seoDescription || data.summary}
  image={data.coverImage}
>
  <article class="project-detail">
    <div class="container">
      <Breadcrumb items={[
        { label: 'Accueil', href: '/' },
        { label: 'Projets', href: '/projets/' },
        { label: data.title },
      ]} />

      <header class="detail-header">
        <div class="header-meta">
          <time datetime={new Date(data.date).toISOString()}>{formattedDate}</time>
          <span class="badge badge-status">{data.status}</span>
          {data.clientName && <span class="client-name">Client : {data.clientName}</span>}
        </div>

        <h1 class="project-title">{data.title}</h1>
        <p class="project-summary">{data.summary}</p>

        {data.stack && data.stack.length > 0 && (
          <div class="stack-tags">
            {data.stack.map((item) => (
              <span class="tag">{item}</span>
            ))}
          </div>
        )}

        {(data.demoUrl || data.repoUrl || data.youtubeUrl) && (
          <div class="project-links">
            {data.demoUrl && (
              <a href={data.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                Voir la démo ↗
              </a>
            )}
            {data.repoUrl && (
              <a href={data.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                Code source (GitHub) ↗
              </a>
            )}
            {data.youtubeUrl && (
              <a href={data.youtubeUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                Voir la vidéo ↗
              </a>
            )}
          </div>
        )}
      </header>

      {/* Rendu conditionnel strict de l'image de couverture */}
      {data.coverImage && (
        <div class="cover-wrapper">
          <img src={data.coverImage} alt={data.title} width="1200" height="675" decoding="async" class="cover-image" />
        </div>
      )}

      <div class="content-body">
        <Content />
      </div>

      {/* Rendu conditionnel strict de la galerie d'images */}
      {data.gallery && data.gallery.length > 0 && (
        <section class="gallery-section">
          <h2>Galerie de captations</h2>
          <div class="gallery-grid">
            {data.gallery.map((imgUrl, index) => (
              <img src={imgUrl} alt={`${data.title} — Captation ${index + 1}`} width="800" height="450" loading="lazy" decoding="async" class="gallery-image" />
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail {
    padding-top: var(--space-4);
  }

  .back-link {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-6);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .detail-header {
    margin-bottom: var(--space-8);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .badge-status {
    border: 1px solid var(--color-border);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .project-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .project-summary {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .tag {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-hover);
    color: var(--color-text);
  }

  .project-links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-6);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--color-accent);
    color: #ffffff;
  }

  .btn-primary:hover {
    background-color: var(--color-accent-hover);
    color: #ffffff;
  }

  .btn-secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
    background-color: var(--color-surface);
  }

  .btn-secondary:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-text);
  }

  .cover-wrapper {
    margin-bottom: var(--space-12);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .cover-image {
    width: 100%;
    max-height: 500px;
    object-fit: cover;
    display: block;
  }

  .content-body {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    max-width: 720px;
    margin-bottom: var(--space-12);
  }

  .content-body :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }

  .content-body :global(p) {
    margin-bottom: var(--space-4);
  }

  .video-section, .gallery-section {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .video-section h2, .gallery-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-6);
  }


  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .gallery-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
</style>
