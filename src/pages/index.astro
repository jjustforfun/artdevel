---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FAQ from '../components/FAQ.astro';
import Marquee from '../components/Marquee.astro';
import { siteConfig } from '../data/site';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => data.locale === 'fr');
const projects = [...allProjects]
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 6);

const allPosts = await getCollection('blog', ({ data }) => data.locale === 'fr' && !data.draft);
const posts = [...allPosts].sort((a,b)=> new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime()).slice(0,3);

const stats = [
  { value: String(allProjects.length), label: "projets livrés" },
  { value: "100", label: "score Lighthouse visé" },
  { value: "AA", label: "WCAG 2.2 sur chaque livraison" },
  { value: "0", label: "traqueur tiers" },
];

const expertises = [
  {
    n: "01",
    title: "Création de site vitrine",
    desc: "Un site qui explique clairement ce que vous faites, rassure et déclenche la prise de contact.",
    tech: "Astro · Accessibilité · SEO local",
    points: ["Parcours mobile-first", "Contenus qui convainquent", "Prise de contact sans friction"],
  },
  {
    n: "02",
    title: "Refonte & modernisation",
    desc: "Repartir d'un site daté pour le rendre lisible, rapide et à nouveau fidèle à votre image.",
    tech: "Design system · Performance · Migration",
    points: ["Navigation clarifiée", "Design actuel & responsive", "Reprise de contenus"],
  },
  {
    n: "03",
    title: "Visibilité Google",
    desc: "Être trouvé au bon moment : structure, contenus et signaux locaux cohérents.",
    tech: "SEO · Sémantique · Netlinking léger",
    points: ["Pages par intention de recherche", "Maillage & métadonnées", "Bases techniques propres"],
  },
  {
    n: "04",
    title: "Assistant intelligent",
    desc: "Un assistant qui répond à partir de vos contenus et oriente vers le bon contact.",
    tech: "LLM · RAG · Astro",
    points: ["Réponses ancrées dans vos pages", "Passe-relais vers RDV / devis", "Cadre maîtrisé & évolutif"],
  },
  {
    n: "05",
    title: "Maintenance & évolution",
    desc: "Le site reste vivant après la mise en ligne : correctifs, contenus, petites features.",
    tech: "Suivi · Sauvegardes · Monitoring",
    points: ["Interventions tracées", "Mises à jour régulières", "Ajouts au fil des besoins"],
  },
  {
    n: "06",
    title: "Performance & éco-conception",
    desc: "Moins de poids, plus de vitesse. Bon pour l'utilisateur, bon pour la planète.",
    tech: "Astro · Images optimisées · 0 JS inutile",
    points: ["< 50 kB de JS en moyenne", "Images adaptatives", "Hébergement sobre"],
  },
];

const audiences = [
  { title: "Indépendants & artisans", desc: "Vous voulez un site qui inspire confiance sans passer vos week-ends à le gérer.", href: "/projets/", label: "Voir un exemple →" },
  { title: "PME / TPE", desc: "Une vitrine qui sert vos objectifs : demandes de devis, prises de RDV, candidatures.", href: "/projets/", label: "Explorer →" },
  { title: "Startups & collectifs", desc: "Aller vite sans sacrifier qualité, accessibilité et scalabilité.", href: "/atelier/", label: "Voir l'atelier →" },
  { title: "Associations & lieux", desc: "Rendre l'information claire, accessible et facile à mettre à jour.", href: "/blog/", label: "Lire le journal →" },
];

const testimonials = [
  { name: "Claire M.", role: "Architecte d'intérieur — Lyon", quote: "Process limpide, site livré en 3 semaines. On reçoit déjà plus de demandes qualifiées. Et le site est ultra rapide.", photo: "/avatars/claire.jpg" },
  { name: "Thomas R.", role: "Gérant, menuiserie — Villeurbanne", quote: "Enfin un site où nos clients trouvent l'info en 30 secondes. Accessible, propre, et on peut le faire évoluer sans friction.", photo: "/avatars/thomas.jpg" },
  { name: "Sophie L.", role: "Collectif associatif — Bron", quote: "Il a su traduire notre univers sans jargon. L'assistant intégré répond à 80% des questions récurrentes.", photo: "/avatars/sophie.jpg" },
];

const faqItems = [
  { question: "Vous travaillez avec de petites structures ?", answer: "Oui — c'est même le cœur de mon activité. Indépendants, artisans, PME et associations : je m'adapte à votre budget et à votre organisation, sans jargon inutile." },
  { question: "Combien coûte un site ?", answer: "Ça dépend du périmètre. Une vitrine claire démarre autour de quelques jours de travail, une refonte plus ambitieuse demande un cadrage. Je propose toujours un chiffrage détaillé et sans surprise." },
  { question: "Quels délais prévoir ?", answer: "Comptez 2 à 5 semaines pour une vitrine selon les contenus disponibles. On cale un planning dès le cadrage et je tiens le rythme." },
  { question: "Et si je n'y connais rien en technique ?", answer: "C'est prévu. J'explique simplement, je m'occupe de la technique et je vous forme à la mise à jour des contenus. Vous gardez la main." },
  { question: "Vous assurez la maintenance & le référencement ?", answer: "Oui. Hébergement, sauvegardes, mises à jour et évolution SEO : je propose un suivi léger et transparent, sans engagement longue durée." },
  { question: "Comment se passe le paiement ?", answer: "Acompte au démarrage, solde à la mise en ligne. Paiement en 2 à 3 fois possible pour lisser la charge." },
];
---

<BaseLayout
  title="Accueil"
  description="Jean Dupont conçoit des sites rapides, accessibles et sobres pour indépendants et PME — pour être trouvés, rassurer et déclencher plus de demandes."
>
  <div class="container">
    <Hero
      eyebrow="Développeur web — Lyon & remote"
      badge="Disponible pour nouveaux projets"
      title={`Un site qui donne envie de <span class="hero-accent">vous choisir</span>.`}
      subtitle="Je conçois des sites rapides, accessibles et sobres pour indépendants, PME et collectifs qui veulent être trouvés, inspirer confiance et recevoir plus de demandes — sans traqueur ni usine à gaz."
      primaryCta={{ label: "Lancer un projet", href: `mailto:${siteConfig.email}` }}
      secondaryCta={{ label: "Voir les réalisations", href: "/projets/" }}
      proofs={["Pensé mobile-first", "Visibilité Google", "Contact sans friction"]}
    />
  </div>

  <!-- Trust strip -->
  <div class="trust-wrap" data-reveal>
    <div class="container trust-inner">
      <span class="trust-label">Ils m'ont fait confiance — artisans, PME, collectifs, associations</span>
    </div>
    <Marquee label="Collaborations et valeurs" items={["Artisans","PME","Associations","Collectifs","Indépendants","Éco-conçu","WCAG AA","Hébergement sobre","0 traqueur","Lyon · Remote"]} />
  </div>

  <!-- Projets -->
  <section class="home-section">
    <div class="container">
      <div class="section-head-row">
        <SectionHeading
          eyebrow="Portfolio · Sélection"
          title="Des projets utiles, pas juste beaux"
          subtitle="Performance, accessibilité et clarté avant l'effet. 6 réalisations où chaque détail compte."
        />
        <a href="/projets/" class="section-link">Tout voir <span aria-hidden="true">→</span></a>
      </div>
      <div class="projects-grid">
        {projects.map((project, i) => (
          <div class="grid-reveal" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Expertises (numérotées façon Clickdev, contenu original) -->
  <section class="home-section surface">
    <div class="container">
      <SectionHeading
        eyebrow="Expertises · 01 — 06"
        title="Ce que je peux faire pour vous"
        subtitle="De l'idée à la mise en ligne : un accompagnement direct, de bout en bout."
      />
      <div class="expert-grid">
        {expertises.map((e, i) => (
          <article class="expert-card" data-glow data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <div class="expert-top">
              <span class="expert-num">{e.n}</span>
              <span class="expert-tech">{e.tech}</span>
            </div>
            <h3 class="expert-title">{e.title}</h3>
            <p class="expert-desc">{e.desc}</p>
            <ul class="expert-points">
              {e.points.map((p) => <li>{p}</li>)}
            </ul>
            <span class="expert-link" aria-hidden="true">Découvrir <span>↗</span></span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Pour qui -->
  <section class="home-section">
    <div class="container">
      <SectionHeading eyebrow="Pour qui" title="Un site adapté à votre réalité" subtitle="Même exigence de qualité, approche différente selon votre contexte." />
      <div class="audience-grid">
        {audiences.map((a,i)=> (
          <article class="audience-card" data-reveal style={`--reveal-delay: ${i*70}ms`}>
            <h3>{a.title}</h3>
            <p>{a.desc}</p>
            <a href={a.href} class="audience-link">{a.label}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="home-section stats-wall" aria-label="Chiffres clés" data-reveal>
    <div class="container">
      <div class="stats-wall-grid">
        {stats.map((s)=> (
          <div class="stats-wall-item">
            <span class="stats-wall-value">{s.value}</span>
            <span class="stats-wall-label">{s.label}</span>
          </div>
        ))}
      </div>
      <p class="stats-wall-note">Objectif : un site qui charge en <strong>&lt; 1,5 s</strong>, score Lighthouse à 100 et aucune dette technique inutile.</p>
    </div>
  </section>

  <!-- Méthode -->
  <section class="home-section surface">
    <div class="container">
      <SectionHeading eyebrow="Méthode · 4 étapes" title="Une méthode transparente, de bout en bout" subtitle="Vous savez où on va, ce que vous payez et quand c'est livré." />
      <ol class="method-timeline">
        <li data-reveal><span class="mt-num">01</span><h3>Échange & cadrage</h3><p>Objectifs, cible, périmètre. Devis clair, planning partagé.</p></li>
        <li data-reveal style="--reveal-delay: 80ms"><span class="mt-num">02</span><h3>Conception & contenus</h3><p>Arborescence, maquettes sobres, contenus qui répondent aux vraies questions.</p></li>
        <li data-reveal style="--reveal-delay: 160ms"><span class="mt-num">03</span><h3>Développement</h3><p>Code propre, accessible, rapide. Aucune dépendance superflue.</p></li>
        <li data-reveal style="--reveal-delay: 240ms"><span class="mt-num">04</span><h3>Tests & mise en ligne</h3><p>Tests réels, accessibilité, performance, formation et suivi.</p></li>
      </ol>
    </div>
  </section>

  <!-- Stack / marquee double -->
  <section class="stack-section" aria-label="Stack technique">
    <div class="container">
      <p class="stack-eyebrow">Stack sobre & moderne</p>
    </div>
    <Marquee label="Technologies principales" items={["Astro","TypeScript","Accessibilité","Performance","SEO","Éco-conception","Markdown","View Transitions"]} />
    <div class="marquee-reverse">
      <Marquee label="Outils et pratiques" items={["Hébergement sobre","Images optimisées","0 cookie tiers","WCAG 2.2 AA","100 Lighthouse","Contenus structurés","Design system","Monitoring léger"]} />
    </div>
  </section>

  <!-- À propos teaser -->
  <section class="home-section">
    <div class="container">
      <div class="about-teaser" data-reveal>
        <div class="about-teaser-media" aria-hidden="true">
          <span class="about-teaser-initials">JD</span>
        </div>
        <div class="about-teaser-body">
          <p class="about-kicker">À propos</p>
          <h2>Développeur à Lyon, culture produit & attention aux détails.</h2>
          <p>J'aime les sites qui vont à l'essentiel : lisibles, rapides, qui respectent l'utilisateur. Je travaille en direct, avec une exigence constante sur la qualité et la clarté — du premier échange au suivi post-livraison.</p>
          <a href="/a-propos/" class="about-link">Découvrir mon parcours <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Témoignages -->
  <section class="home-section surface">
    <div class="container">
      <SectionHeading eyebrow="Témoignages" title="Ils en parlent le mieux" subtitle="Retours d'artisans, PME et collectifs accompagnés récemment." />
      <div class="testi-grid">
        {testimonials.map((t, i)=> (
          <div data-reveal style={`--reveal-delay: ${i*80}ms`} class="grid-reveal">
            <TestimonialCard name={t.name} role={t.role} quote={t.quote} photo={t.photo} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="home-section">
    <div class="container">
      <SectionHeading eyebrow="FAQ" title="Questions fréquentes" subtitle="De quoi lever les derniers freins avant de se lancer." />
      <FAQ items={faqItems} title="" />
    </div>
  </section>

  <!-- Blog -->
  {posts.length > 0 && (
    <section class="home-section surface">
      <div class="container">
        <div class="section-head-row">
          <SectionHeading eyebrow="Journal" title="Carnet de bord" subtitle="Éco-conception, accessibilité, retours de terrain : notes courtes et utiles." />
          <a href="/blog/" class="section-link">Tous les articles <span aria-hidden="true">→</span></a>
        </div>
        <div class="blog-grid">
          {posts.map((post,i)=> (
            <div data-reveal style={`--reveal-delay: ${i*80}ms`} class="grid-reveal">
              <ArticleCard article={post} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Final CTA - oversized comme Clickdev mais identité propre -->
  <section class="final-cta-wrap" data-reveal>
    <div class="container">
      <div class="final-cta">
        <p class="final-cta-eyebrow">Un projet en tête ?</p>
        <h2 class="final-cta-title">Parlons-en<br /><span class="final-cta-accent">maintenant.</span></h2>
        <p class="final-cta-text">Décrivez votre activité en quelques lignes — je reviens vers vous sous 24h avec une première lecture claire et sans engagement.</p>
        <div class="final-cta-actions">
          <a href={`mailto:${siteConfig.email}`} class="btn-final-primary" data-magnetic>Écrire à {siteConfig.email} <span aria-hidden="true">→</span></a>
          <a href="/projets/" class="btn-final-secondary">Voir les réalisations</a>
        </div>
        <p class="final-cta-note">Basé à Lyon · Remote partout en France · Réponse humaine, pas de bot commercial.</p>
      </div>
    </div>
  </section>

  <section class="home-section geo-local-section" data-reveal>
    <div class="container">
      <div class="geo-card">
        <h2>Basé à Lyon, disponible partout en France</h2>
        <p>Depuis <strong>Lyon</strong>, j'accompagne les professionnels d'Auvergne-Rhône-Alpes (Villeurbanne, Bron, Vénissieux) et à distance partout en France. Échanges directs, délais tenus, site qui dure.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-section { padding-top: var(--space-24); padding-bottom: var(--space-24); }
  .home-section.surface { background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .section-head-row { display: flex; align-items: end; justify-content: space-between; gap: var(--space-6); flex-wrap: wrap; }
  .section-link { font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; }
  .section-link:hover { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }

  .trust-wrap { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: var(--color-surface); }
  .trust-inner { padding: 10px 1rem 6px; }
  .trust-label { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }

  .projects-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); margin-top: var(--space-8); }
  @media (min-width: 640px){ .projects-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (min-width: 1024px){ .projects-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }

  .expert-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-5); margin-top: var(--space-10); }
  @media (min-width: 760px){ .expert-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (min-width: 1100px){ .expert-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }

  .expert-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    box-shadow: var(--shadow-sm);
    transition: transform 220ms var(--ease), border-color 220ms var(--ease), box-shadow 220ms var(--ease);
    position: relative;
    overflow: hidden;
  }
  .expert-card:hover { transform: translateY(-4px); border-color: var(--color-accent); box-shadow: var(--shadow-md); }
  .expert-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 60%, var(--color-energy)));
    opacity: 0;
    transition: opacity 220ms var(--ease);
  }
  .expert-card:hover::before { opacity: 1; }
  .expert-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .expert-num { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; color: var(--color-accent); background: var(--color-accent-light); border-radius: var(--radius-full); padding: 3px 8px; }
  .expert-tech { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-muted); text-align: right; }
  .expert-title { font-size: 1.05rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin-top: var(--space-1); }
  .expert-desc { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.55; }
  .expert-points { list-style: none; display: flex; flex-direction: column; gap: 6px; margin-top: var(--space-2); }
  .expert-points li { font-size: 0.84rem; color: var(--color-text-muted); display: flex; gap: 8px; align-items: flex-start; }
  .expert-points li::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--color-accent); margin-top: 7px; flex: none; opacity: 0.9; }
  .expert-link { margin-top: auto; padding-top: var(--space-4); font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); display: inline-flex; gap: 6px; align-items: center; border-top: 1px dashed var(--color-border); }
  .expert-link span { transition: transform 180ms var(--ease); }
  .expert-card:hover .expert-link span { transform: translate(2px,-1px); }

  .audience-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-5); margin-top: var(--space-8); }
  @media (min-width: 740px){ .audience-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (min-width: 1024px){ .audience-grid { grid-template-columns: repeat(4, minmax(0,1fr)); } }
  .audience-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: var(--space-3); transition: transform 200ms var(--ease), border-color 200ms var(--ease), box-shadow 200ms var(--ease); }
  .audience-card:hover { transform: translateY(-3px); border-color: var(--color-accent); box-shadow: var(--shadow-md); }
  .audience-card h3 { font-size: 1rem; font-weight: 700; letter-spacing: -0.02em; }
  .audience-card p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.55; flex: 1; }
  .audience-link { font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); }
  .audience-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .stats-wall { background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .stats-wall-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: var(--space-8); text-align: center; }
  @media (min-width: 780px){ .stats-wall-grid { grid-template-columns: repeat(4,1fr); } }
  .stats-wall-value { display: block; font-family: var(--font-mono); font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; letter-spacing: -0.05em; line-height: 1; color: var(--color-accent); }
  .stats-wall-label { display: block; margin-top: 8px; font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.4; }
  .stats-wall-note { margin-top: var(--space-8); text-align: center; font-size: var(--text-sm); color: var(--color-text-muted); max-width: 680px; margin-left: auto; margin-right: auto; }
  .stats-wall-note strong { color: var(--color-text); }

  .method-timeline { list-style: none; display: grid; grid-template-columns: 1fr; gap: var(--space-5); margin-top: var(--space-8); position: relative; }
  @media (min-width: 860px){ .method-timeline { grid-template-columns: repeat(4,1fr); } }
  .method-timeline li { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); box-shadow: var(--shadow-sm); position: relative; }
  .method-timeline li:hover { border-color: var(--color-accent); box-shadow: var(--shadow-md); transform: translateY(-2px); transition: all 200ms var(--ease); }
  .mt-num { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius-full); background: var(--color-accent); color: var(--color-accent-contrast); font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; margin-bottom: var(--space-3); }
  .method-timeline h3 { font-size: 1rem; margin-bottom: 6px; letter-spacing: -0.02em; }
  .method-timeline p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.55; }

  .stack-section { padding: 24px 0 8px; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: var(--color-bg); overflow: hidden; }
  .stack-eyebrow { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 12px; }
  .marquee-reverse :global(.marquee-track) { animation-direction: reverse; }

