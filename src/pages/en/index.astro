---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import FAQ from '../../components/FAQ.astro';
import Marquee from '../../components/Marquee.astro';
import { siteConfig } from '../../data/site';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => data.locale === 'en');
const projects = [...allProjects]
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 6);

const allPosts = await getCollection('blog', ({ data }) => data.locale === 'en' && !data.draft);
const posts = [...allPosts].sort((a,b)=> new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime()).slice(0,3);

const stats = [
  { value: String(allProjects.length), label: "projects delivered" },
  { value: "100", label: "Lighthouse target" },
  { value: "AA", label: "WCAG 2.2 on every build" },
  { value: "0", label: "third-party trackers" },
];

const expertises = [
  {
    n: "01",
    title: "Business websites",
    desc: "A site that explains what you do, builds trust and triggers contact — clearly.",
    tech: "Astro · A11y · Local SEO",
    points: ["Mobile-first journeys", "Persuasive structure", "Frictionless contact"],
  },
  {
    n: "02",
    title: "Redesign & modernization",
    desc: "Turn a dated, hard-to-use site into a fast, readable and true-to-you presence.",
    tech: "Design system · Performance · Migration",
    points: ["Clear navigation", "Modern responsive design", "Content migration"],
  },
  {
    n: "03",
    title: "Google visibility",
    desc: "Be found at the right moment: structure, content and consistent local signals.",
    tech: "SEO · Semantics · Clean tech",
    points: ["Pages by search intent", "Structured data", "Solid technical base"],
  },
  {
    n: "04",
    title: "Smart assistant",
    desc: "An assistant answering from your own content and routing to the right next step.",
    tech: "LLM · RAG · Astro",
    points: ["Answers grounded in your pages", "Handoff to booking / quote", "Controlled & evolutive"],
  },
  {
    n: "05",
    title: "Care & evolution",
    desc: "The site stays alive after launch: fixes, content, small features as needs evolve.",
    tech: "Support · Backups · Monitoring",
    points: ["Traceable interventions", "Regular updates", "Iterative improvements"],
  },
  {
    n: "06",
    title: "Performance & eco-design",
    desc: "Less weight, more speed. Better for users and for the planet.",
    tech: "Astro · Optimized images · No bloat",
    points: ["< 50 kB JS on average", "Adaptive images", "Sustainable hosting"],
  },
];

const audiences = [
  { title: "Freelancers & craftspeople", desc: "You need a site that earns trust without eating your weekends.", href: "/en/projects/", label: "See an example →" },
  { title: "Small & medium businesses", desc: "A showcase that drives enquiries, bookings and applications.", href: "/en/projects/", label: "Explore →" },
  { title: "Startups & collectives", desc: "Move fast without sacrificing quality, a11y or scalability.", href: "/en/playground/", label: "See playground →" },
  { title: "Non-profits & venues", desc: "Clear, accessible information that's easy to keep up to date.", href: "/en/blog/", label: "Read the journal →" },
];

const testimonials = [
  { name: "Claire M.", role: "Interior designer — Lyon", quote: "Clear process, delivered in 3 weeks. We're already getting more qualified enquiries. And the site is blazing fast.", photo: "/avatars/claire.jpg" },
  { name: "Thomas R.", role: "Owner, joinery — Villeurbanne", quote: "Finally a site where our clients find what they need in 30 seconds. Accessible, clean, easy to evolve.", photo: "/avatars/thomas.jpg" },
  { name: "Sophie L.", role: "Non-profit collective — Bron", quote: "He captured our spirit without jargon. The built-in assistant handles 80% of recurring questions.", photo: "/avatars/sophie.jpg" },
];

const faqItems = [
  { question: "Do you work with small businesses?", answer: "Yes — that's my core. Freelancers, artisans, SMBs and non-profits: I adapt to your budget and workflow, with no unnecessary jargon." },
  { question: "How much does a site cost?", answer: "Depends on scope. A clear showcase starts at a few days of work; a fuller redesign needs scoping. I always provide a detailed, no-surprise quote." },
  { question: "What timelines should I expect?", answer: "2 to 5 weeks for a showcase depending on content readiness. We lock a schedule at kickoff and I keep the pace." },
  { question: "What if I'm not technical?", answer: "That's expected. I explain simply, handle the tech, and train you to update content. You stay in control." },
  { question: "Do you handle maintenance & SEO?", answer: "Yes — hosting, backups, updates and SEO follow-up. Light, transparent care with no long-term lock-in." },
  { question: "How does payment work?", answer: "Deposit at start, balance on launch. 2–3 instalments possible to spread the cost." },
];
---

<BaseLayout
  title="Home"
  description="Jean Dupont builds fast, accessible, low-impact websites for freelancers and small businesses — to be found, earn trust and get more enquiries."
>
  <div class="container">
    <Hero
      eyebrow="Web developer — Lyon & remote"
      badge="Available for new projects"
      title={`A website that makes people want to <span class="hero-accent">choose you</span>.`}
      subtitle="I build fast, accessible, low-impact websites for freelancers, small businesses and collectives who want to be found, earn trust and get more enquiries — without trackers or bloat."
      primaryCta={{ label: "Start a project", href: `mailto:${siteConfig.email}` }}
      secondaryCta={{ label: "View work", href: "/en/projects/" }}
      proofs={["Built for mobile", "Google visibility", "Frictionless contact"]}
    />
  </div>

  <div class="trust-wrap" data-reveal>
    <div class="container trust-inner">
      <span class="trust-label">Trusted by — craftspeople, SMBs, collectives, non-profits</span>
    </div>
    <Marquee label="Collaborations and values" items={["Craftspeople","SMBs","Non-profits","Collectives","Freelancers","Eco-designed","WCAG AA","Sustainable hosting","0 trackers","Lyon · Remote"]} />
  </div>

  <section class="home-section">
    <div class="container">
      <div class="section-head-row">
        <SectionHeading
          eyebrow="Portfolio · Selection"
          title="Work that is useful, not just pretty"
          subtitle="Performance, accessibility and clarity before gimmicks. 6 recent projects where every detail matters."
        />
        <a href="/en/projects/" class="section-link">View all <span aria-hidden="true">→</span></a>
      </div>
      <div class="projects-grid">
        {projects.map((project, i) => (
          <div class="grid-reveal" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section surface">
    <div class="container">
      <SectionHeading
        eyebrow="Expertise · 01 — 06"
        title="What I can do for you"
        subtitle="From idea to launch: hands-on, end-to-end support."
      />
      <div class="expert-grid">
        {expertises.map((e, i) => (
          <article class="expert-card" data-glow data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <div class="expert-top">
              <span class="expert-num">{e.n}</span>
              <span class="expert-tech">{e.tech}</span>
            </div>
            <h3 class="expert-title">{e.title}</h3>
            <p class="expert-desc">{e.desc}</p>
            <ul class="expert-points">
              {e.points.map((p) => <li>{p}</li>)}
            </ul>
            <span class="expert-link" aria-hidden="true">Discover <span>↗</span></span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container">
      <SectionHeading eyebrow="For whom" title="A site fitted to your reality" subtitle="Same quality bar, different approach depending on your context." />
      <div class="audience-grid">
        {audiences.map((a,i)=> (
          <article class="audience-card" data-reveal style={`--reveal-delay: ${i*70}ms`}>
            <h3>{a.title}</h3>
            <p>{a.desc}</p>
            <a href={a.href} class="audience-link">{a.label}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section stats-wall" aria-label="Key figures" data-reveal>
    <div class="container">
      <div class="stats-wall-grid">
        {stats.map((s)=> (
          <div class="stats-wall-item">
            <span class="stats-wall-value">{s.value}</span>
            <span class="stats-wall-label">{s.label}</span>
          </div>
        ))}
      </div>
      <p class="stats-wall-note">Goal: a site that loads in <strong>&lt; 1.5 s</strong>, hits Lighthouse 100 and carries no needless debt.</p>
    </div>
  </section>

  <section class="home-section surface">
    <div class="container">
      <SectionHeading eyebrow="Process · 4 steps" title="A transparent, end-to-end workflow" subtitle="You know where we're headed, what it costs and when it ships." />
      <ol class="method-timeline">
        <li data-reveal><span class="mt-num">01</span><h3>Discovery & scoping</h3><p>Goals, audience, scope. Clear quote, shared timeline.</p></li>
        <li data-reveal style="--reveal-delay: 80ms"><span class="mt-num">02</span><h3>Design & content</h3><p>Sitemap, understated mockups, content that answers real questions.</p></li>
        <li data-reveal style="--reveal-delay: 160ms"><span class="mt-num">03</span><h3>Build</h3><p>Clean, accessible, fast code. No bloat, no dark patterns.</p></li>
        <li data-reveal style="--reveal-delay: 240ms"><span class="mt-num">04</span><h3>Test & launch</h3><p>Real-device tests, a11y & performance checks, handover and care.</p></li>
      </ol>
    </div>
  </section>

  <section class="stack-section" aria-label="Tech stack">
    <div class="container">
      <p class="stack-eyebrow">Lean & modern stack</p>
    </div>
    <Marquee label="Core technologies" items={["Astro","TypeScript","Accessibility","Performance","SEO","Eco-design","Markdown","View Transitions"]} />
    <div class="marquee-reverse">
      <Marquee label="Tools and practices" items={["Sustainable hosting","Optimized images","0 third-party cookies","WCAG 2.2 AA","100 Lighthouse","Structured content","Design system","Light monitoring"]} />
    </div>
  </section>

  <section class="home-section">
    <div class="container">
      <div class="about-teaser" data-reveal>
        <div class="about-teaser-media" aria-hidden="true">
          <span class="about-teaser-initials">JD</span>
        </div>
        <div class="about-teaser-body">
          <p class="about-kicker">About</p>
          <h2>Developer in Lyon, product mindset & eye for detail.</h2>
          <p>I like sites that get to the point: readable, fast, respectful of users. I work directly with you, with a steady bar on quality and clarity — from first chat to post-launch.</p>
          <a href="/en/about/" class="about-link">More about me <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section surface">
    <div class="container">
      <SectionHeading eyebrow="Testimonials" title="They say it best" subtitle="Feedback from craftspeople, SMBs and collectives I recently worked with." />
      <div class="testi-grid">
        {testimonials.map((t, i)=> (
          <div data-reveal style={`--reveal-delay: ${i*80}ms`} class="grid-reveal">
            <TestimonialCard name={t.name} role={t.role} quote={t.quote} photo={t.photo} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container">
      <SectionHeading eyebrow="FAQ" title="Frequent questions" subtitle="Clearing the last doubts before we start." />
      <FAQ items={faqItems} title="" />
    </div>
  </section>

  {posts.length > 0 && (
    <section class="home-section surface">
      <div class="container">
        <div class="section-head-row">
          <SectionHeading eyebrow="Journal" title="Field notes" subtitle="Eco-design, accessibility, lessons from the field — short, useful notes." />
          <a href="/en/blog/" class="section-link">All articles <span aria-hidden="true">→</span></a>
        </div>
        <div class="blog-grid">
          {posts.map((post,i)=> (
            <div data-reveal style={`--reveal-delay: ${i*80}ms`} class="grid-reveal">
              <ArticleCard article={post} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="final-cta-wrap" data-reveal>
    <div class="container">
      <div class="final-cta">
        <p class="final-cta-eyebrow">Have a project in mind?</p>
        <h2 class="final-cta-title">Let's talk<br /><span class="final-cta-accent">now.</span></h2>
        <p class="final-cta-text">Drop me a few lines about your business — I’ll get back within 24h with a clear first take, no strings attached.</p>
        <div class="final-cta-actions">
          <a href={`mailto:${siteConfig.email}`} class="btn-final-primary" data-magnetic>Email {siteConfig.email} <span aria-hidden="true">→</span></a>
          <a href="/en/projects/" class="btn-final-secondary">See work</a>
        </div>
        <p class="final-cta-note">Based in Lyon · Remote across France · Human reply, no sales bot.</p>
      </div>
    </div>
  </section>

  <section class="home-section geo-local-section" data-reveal>
    <div class="container">
      <div class="geo-card">
        <h2>Based in Lyon, available across France</h2>
        <p>From <strong>Lyon</strong>, I support professionals in Auvergne-Rhône-Alpes (Villeurbanne, Bron, Vénissieux) and remotely across France. Direct exchanges, deadlines kept, a site that lasts.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-section { padding-top: var(--space-24); padding-bottom: var(--space-24); }
  .home-section.surface { background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .section-head-row { display: flex; align-items: end; justify-content: space-between; gap: var(--space-6); flex-wrap: wrap; }
  .section-link { font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; }
  .section-link:hover { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }

  .trust-wrap { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: var(--color-surface); }
  .trust-inner { padding: 10px 1rem 6px; }
  .trust-label { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }

  .projects-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); margin-top: var(--space-8); }
  @media (min-width: 640px){ .projects-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (min-width: 1024px){ .projects-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }

  .expert-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-5); margin-top: var(--space-10); }
  @media (min-width: 760px){ .expert-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (min-width: 1100px){ .expert-grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }

  .expert-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    box-shadow: var(--shadow-sm);
    transition: transform 220ms var(--ease), border-color 220ms var(--ease), box-shadow 220ms var(--ease);
    position: relative;
    overflow: hidden;
  }
  .expert-card:hover { transform: translateY(-4px); border-color: var(--color-accent); box-shadow: var(--shadow-md); }
  .expert-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 60%, var(--color-energy)));
    opacity: 0;
    transition: opacity 220ms var(--ease);
  }
  .expert-card:hover::before { opacity: 1; }
  .expert-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .expert-num { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; color: var(--color-accent); background: var(--color-accent-light); border-radius: var(--radius-full); padding: 3px 8px; }
  .expert-tech { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-muted); text-align: right; }
  .expert-title { font-size: 1.05rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin-top: var(--space-1); }
  .expert-desc { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.55; }
  .expert-points { list-style: none; display: flex; flex-direction: column; gap: 6px; margin-top: var(--space-2); }
  .expert-points li { font-size: 0.84rem; color: var(--color-text-muted); display: flex; gap: 8px; align-items: flex-start; }
  .expert-points li::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--color-accent); margin-top: 7px; flex: none; opacity: 0.9; }
  .expert-link { margin-top: auto; padding-top: var(--space-4); font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); display: inline-flex; gap: 6px; align-items: center; border-top: 1px dashed var(--color-border); }
  .expert-link span { transition: transform 180ms var(--ease); }
  .expert-card:hover .expert-link span { transform: translate(2px,-1px); }

  .audience-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-5); margin-top: var(--space-8); }
  @media (min-width: 740px){ .audience-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (min-width: 1024px){ .audience-grid { grid-template-columns: repeat(4, minmax(0,1fr)); } }
  .audience-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: var(--space-3); transition: transform 200ms var(--ease), border-color 200ms var(--ease), box-shadow 200ms var(--ease); }
  .audience-card:hover { transform: translateY(-3px); border-color: var(--color-accent); box-shadow: var(--shadow-md); }
  .audience-card h3 { font-size: 1rem; font-weight: 700; letter-spacing: -0.02em; }
  .audience-card p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.55; flex: 1; }
  .audience-link { font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); }
  .audience-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .stats-wall { background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .stats-wall-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: var(--space-8); text-align: center; }
  @media (min-width: 780px){ .stats-wall-grid { grid-template-columns: repeat(4,1fr); } }
  .stats-wall-value { display: block; font-family: var(--font-mono); font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; letter-spacing: -0.05em; line-height: 1; color: var(--color-accent); }
  .stats-wall-label { display: block; margin-top: 8px; font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.4; }
  .stats-wall-note { margin-top: var(--space-8); text-align: center; font-size: var(--text-sm); color: var(--color-text-muted); max-width: 680px; margin-left: auto; margin-right: auto; }
  .stats-wall-note strong { color: var(--color-text); }

  .method-timeline { list-style: none; display: grid; grid-template-columns: 1fr; gap: var(--space-5); margin-top: var(--space-8); position: relative; }
  @media (min-width: 860px){ .method-timeline { grid-template-columns: repeat(4,1fr); } }
  .method-timeline li { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); box-shadow: var(--shadow-sm); position: relative; }
  .method-timeline li:hover { border-color: var(--color-accent); box-shadow: var(--shadow-md); transform: translateY(-2px); transition: all 200ms var(--ease); }
  .mt-num { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius-full); background: var(--color-accent); color: var(--color-accent-contrast); font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; margin-bottom: var(--space-3); }
  .method-timeline h3 { font-size: 1rem; margin-bottom: 6px; letter-spacing: -0.02em; }
  .method-timeline p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.55; }

  .stack-section { padding: 24px 0 8px; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: var(--color-bg); overflow: hidden; }
  .stack-eyebrow { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 12px; }
  .marquee-reverse :global(.marquee-track) { animation-direction: reverse; }

  .about-teaser { display: grid; grid-template-columns: 1fr; gap: var(--space-8); align-items: center; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-8); box-shadow: var(--shadow-sm); }
  @media (min-width: 760px){ .about-teaser { grid-template-columns: 140px 1fr; } }
  .about-teaser-media { width: 120px; height: 120px; border-radius: 24px; background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 18%, var(--surface)), color-mix(in srgb, var(--cta) 14%, var(--surface))); border: 1px solid var(--color-border); display: grid; place-items: center; }
  .about-teaser-initials { font-family: var(--font-mono); font-size: 1.8rem; font-weight: 700; letter-spacing: -0.04em; color: var(--color-accent); }
  .about-kicker { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 6px; }
  .about-teaser-body h2 { font-size: clamp(1.35rem, 3vw, 1.9rem); line-height: 1.12; letter-spacing: -0.03em; margin-bottom: 10px; }
  .about-teaser-body p { color: var(--color-text-muted); line-height: 1.6; max-width: 60ch; }
  .about-link { display: inline-flex; margin-top: 14px; font-weight: 600; color: var(--color-accent); gap: 6px; }
  .about-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .testi-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); margin-top: var(--space-8); }
  @media (min-width: 860px){ .testi-grid { grid-template-columns: repeat(3,1fr); } }

  .blog-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); margin-top: var(--space-8); }
  @media (min-width: 860px){ .blog-grid { grid-template-columns: repeat(3,1fr); } }

  .final-cta-wrap { padding: var(--space-24) 0; background: var(--color-surface); border-top: 1px solid var(--color-border); }
