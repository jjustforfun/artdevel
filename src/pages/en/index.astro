---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import Hero from '../../components/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StatsStrip from '../../components/StatsStrip.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import MethodSteps from '../../components/MethodSteps.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Marquee from '../../components/Marquee.astro';
import ContactForm from '../../components/ContactForm.astro';
import { siteConfig } from '../../data/site';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => data.locale === 'en');
const projects = [...allProjects]
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3);

const stats = [
  { value: String(allProjects.length), label: "projects delivered for clients" },
  { value: "0", label: "third-party cookies or trackers" },
  { value: "AA", label: "WCAG 2.2 compliance on every delivery" },
  { value: "100", label: "target Lighthouse performance score" },
];

const services = [
  {
    icon: "globe",
    title: "Websites for professionals",
    description: "A website built around your business, your customers, and the actions you want visitors to take.",
    points: ["Structure built to persuade", "Mobile-first journeys", "Frictionless contact requests"],
  },
  {
    icon: "gauge",
    title: "Website redesign",
    description: "A fresh start for a dated website that is hard to use or no longer reflects your business.",
    points: ["Clearer content and navigation", "Current, responsive design", "Supported launch"],
  },
  {
    icon: "globe",
    title: "Visibility on Google",
    description: "A structure and content system that helps future customers find you when they search for your services.",
    points: ["Pages organized by intent", "Consistent local signals", "Clean technical foundations"],
  },
  {
    icon: "sparkles",
    title: "Intelligent assistant integration",
    description: "A virtual assistant that answers common visitor questions and guides them to the right next step.",
    points: ["Answers grounded in your content", "Guidance to contact or booking", "Controlled, evolving setup"],
  },
  {
    icon: "wrench",
    title: "Maintenance and evolution",
    description: "Your website keeps working after launch: fixes, updates, and new features as your needs change.",
    points: ["Clear interventions", "Long-term support", "Evolution over time"],
  },
];

const methodSteps = [
  {
    title: "Discovery & scoping",
    description: "We define your goals, audience, and scope. You know exactly what you're paying for.",
  },
  {
    title: "Design & content",
    description: "Structure, user journeys, and conversion-focused content — before the first line of code.",
  },
  {
    title: "Development & testing",
    description: "I build, test, and validate accessibility, performance, and compatibility end to end.",
  },
  {
    title: "Launch & support",
    description: "A careful deployment, onboarding, and ongoing support so your site lasts.",
  },
];
---

<BaseLayout
  title="Home"
  description="Jean Dupont creates and redesigns websites for professionals who want to be found, build trust, and receive more enquiries."
>
  <div class="container">
    <!-- Hero -->
    <Hero
      badge="Available for new projects"
      title={`
        A website that makes people want to
        <span class="hero-accent"> choose you</span>.
      `}
      subtitle="I create and redesign websites for professionals who want to be found, build trust, and receive more enquiries."
      primaryCta={{ label: "Start a project", href: `mailto:${siteConfig.email}` }}
      secondaryCta={{ label: "View work", href: "/en/projects/" }}
      proofs={["Built for mobile", "Google visibility", "Frictionless contact"]}
    />
  </div>

  <!-- Proof -->
  <section class="home-section stats-section" aria-label="Key numbers & results" data-reveal>
    <div class="container">
      <StatsStrip items={stats} />
    </div>
  </section>

  <!-- Marquee -->
  <Marquee
    label="Values and technologies"
    items={[
      "WCAG 2.2 AA",
      "0 third-party cookies",
      "Eco-designed",
      "100% Lighthouse",
      "Astro · TypeScript",
      "Accessibility",
    ]}
  />

  <!-- Services -->
  <section class="home-section">
    <div class="container">
      <SectionHeading
        eyebrow="What I can build"
        title="A website that works for your business"
        subtitle="Creation, redesign, and evolution: every project starts with your business and ends with a presence that makes people act."
      />
      <div class="services-grid">
        {services.map((service, index) => (
          <div class="grid-reveal" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
            <ServiceCard
              icon={service.icon}
              title={service.title}
              description={service.description}
              points={service.points}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Selected projects -->
  <section class="home-section projects-section">
    <div class="container">
      <SectionHeading
        eyebrow="Work"
        title="Selected projects"
        subtitle="A snapshot of recent work blending accessibility, eco-design, and business impact."
      />
      <div class="projects-grid">
        {projects.map((project, index) => (
          <div class="grid-reveal" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
      <div class="section-cta">
        <CTAButton href="/en/projects/" variant="secondary">All projects →</CTAButton>
      </div>
    </div>
  </section>

  <!-- Method -->
  <section class="home-section method-section">
    <div class="container">
      <SectionHeading
        eyebrow="Process"
        title="A transparent workflow"
        subtitle="A structured four-step approach to ensure your project's success."
      />
      <MethodSteps steps={methodSteps} />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="home-section" data-reveal>
    <div class="container">
      <div class="final-cta">
        <p class="final-cta-eyebrow">Let's talk about your project</p>
        <h2 class="final-cta-title">Ready to optimize your online presence?</h2>
        <p class="final-cta-text">
          Tell me about your business and your goal. I will come back to you with an initial view of your needs.
        </p>
        <ContactForm locale="en" compact />
        <div class="social-links">
          <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span class="separator">/</span>
          <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Local presence -->
  <section class="home-section geo-local-section" data-reveal>
    <div class="container">
      <div class="geo-card">
        <h2>Based in Lyon, available across France</h2>
        <p>
          Based in <strong>Lyon, France</strong>, I work with professionals across the Auvergne-Rhône-Alpes region (Villeurbanne, Bron, Vénissieux) and remotely across France. Every exchange stays direct, clear, and adapted to your business.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-section {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }

  .stats-section {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-12);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .projects-section {
    background-color: var(--color-surface);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-8);
    margin-top: var(--space-12);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .section-cta {
    margin-top: var(--space-12);
    text-align: center;
  }

  .method-section {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .final-cta {
    background-color: var(--color-accent);
    background-image: radial-gradient(
      circle at 15% 15%,
      color-mix(in srgb, var(--color-energy) 28%, transparent),
      transparent 60%
    );
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-6);
    text-align: center;
    max-width: 860px;
    margin: 0 auto;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .final-cta-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-contrast);
    opacity: 0.85;
    margin-bottom: var(--space-3);
  }

  .final-cta-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
    color: var(--color-accent-contrast);
  }

  .final-cta-text {
    font-size: var(--text-lg);
    color: var(--color-accent-contrast);
    opacity: 0.9;
    margin-bottom: var(--space-8);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
    line-height: var(--leading-relaxed);
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent-contrast);
    opacity: 0.92;
  }

  .social-links a:hover {
    color: var(--color-accent-contrast);
    text-decoration: underline;
  }

  .separator {
    opacity: 0.4;
  }

  .geo-local-section {
    padding-top: var(--space-12);
  }

  .geo-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    max-width: 720px;
    box-shadow: var(--shadow-sm);
  }

  .geo-card h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .geo-card p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }
</style>
