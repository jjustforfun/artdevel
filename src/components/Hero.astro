---
interface Props {
  badge?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  proofs?: string[];
}

const {
  badge = "Disponible pour nouveaux projets",
  eyebrow = "Développeur web — Lyon & remote",
  title = "Je conçois des sites web rapides et efficaces pour les indépendants et PME.",
  subtitle = "Développeur web · Lyon, France",
  primaryCta = { label: "Voir mes projets", href: "/projets/" },
  secondaryCta = { label: "Me contacter", href: "/a-propos/" },
  proofs = [],
} = Astro.props;

const titleLines = title
  .split(/<br\s*\/?>|\n/)
  .map((line) => line.trim())
  .filter(Boolean);
---

<section class="hero">
  <div class="hero-dots" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <p class="hero-eyebrow">{eyebrow}</p>

  <div class="hero-badge">
    <span class="hero-badge-dot" aria-hidden="true"></span>
    <span>{badge}</span>
    <span class="hero-badge-sep" aria-hidden="true">·</span>
    <span class="hero-badge-muted">réponse sous 24h</span>
  </div>

  <h1 class="hero-title">
    {
      titleLines.length > 1 ? (
        titleLines.map((line) => <span class="hero-title-line" set:html={line} />)
      ) : (
        <span class="hero-title-line" set:html={title} />
      )
    }
  </h1>

  <p class="hero-subtitle">{subtitle}</p>

  <div class="hero-actions">
    <a href={primaryCta.href} class="btn-hero-primary" data-magnetic data-magnetic-strength="0.18">
      {primaryCta.label}
      <span aria-hidden="true" class="btn-arrow">→</span>
    </a>
    <a href={secondaryCta.href} class="btn-hero-secondary" data-magnetic data-magnetic-strength="0.18">
      {secondaryCta.label}
    </a>
  </div>

  {
    proofs && proofs.length > 0 && (
      <ul class="hero-proofs">
        {proofs.map((proof) => (
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
            <span>{proof}</span>
          </li>
        ))}
      </ul>
    )
  }

  <p class="hero-tagline" aria-hidden="true">Idée — Maquette — Site en ligne</p>
</section>

<script>
  function initHeroParallax() {
    if (window.matchMedia('(prefers-reduced-motion: reduce), (max-width: 768px), (pointer: coarse)').matches) return;
    const dots = document.querySelector('.hero-dots') as HTMLElement | null;
    const glow = document.querySelector('.hero-glow') as HTMLElement | null;
    if (!dots || dots.hasAttribute('data-init')) return;
    dots.setAttribute('data-init', '');
    let ticking = false;
    const update = () => {
      const hero = dots.closest('.hero') as HTMLElement | null;
      if (hero) {
        const rect = hero.getBoundingClientRect();
        const p = Math.min(Math.max(-rect.top / (rect.height || 1), 0), 1);
        dots.style.transform = `translateY(${p * 28}px)`;
        if (glow) glow.style.transform = `translateY(${p * -18}px)`;
      }
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
  }
  const sched = (cb: () => void) => {
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(cb, { timeout: 1200 });
    else setTimeout(cb, 60);
  };
  document.addEventListener('astro:page-load', () => sched(initHeroParallax));
  sched(initHeroParallax);
</script>

<style>
  .hero {
    position: relative;
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    max-width: 980px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    isolation: isolate;
  }

  .hero-dots {
    position: absolute;
    inset: -1rem -2rem 0 -2rem;
    pointer-events: none;
    z-index: 0;
    opacity: 0.045;
    background-image: radial-gradient(var(--text) 1.6px, transparent 1.6px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 82% 72% at 28% 28%, black 38%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 82% 72% at 28% 28%, black 38%, transparent 78%);
  }

  .hero-glow {
    position: absolute;
    width: 560px;
    height: 560px;
    left: -80px;
    top: -120px;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--accent) 14%, transparent) 0%, transparent 70%);
    opacity: 0.9;
  }

  [data-theme="dark"] .hero-dots { opacity: 0.085; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .hero-dots { opacity: 0.085; }
  }

  .hero-eyebrow {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .hero-badge {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding: 7px 14px;
    border-radius: var(--radius-full);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: var(--font-size-small);
    font-weight: 500;
    margin-bottom: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .hero-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    position: relative;
    flex: none;
  }
  .hero-badge-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: var(--success);
    opacity: 0.55;
    animation: pulse-dot 2.2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0% { transform: scale(0.85); opacity: 0.7; }
    50% { transform: scale(1.7); opacity: 0; }
    100% { transform: scale(0.85); opacity: 0; }
  }
  .hero-badge-sep { opacity: 0.35; }
  .hero-badge-muted { color: var(--text-muted); font-weight: 400; }

  .hero-title {
    position: relative;
    z-index: 1;
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.92;
    color: var(--text);
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 0.06em;
    max-width: 18ch;
    text-wrap: balance;
  }
  .hero-title-line { display: block; }
  .hero-title :global(.hero-accent) {
    font-family: var(--font-brand);
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.02em;
    color: var(--accent);
    position: relative;
  }
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .hero-title :global(.hero-accent) {
      background: linear-gradient(135deg, var(--accent) 18%, color-mix(in srgb, var(--accent) 72%, var(--color-energy)) 92%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
  }

  .hero-subtitle {
    position: relative;
    z-index: 1;
    font-size: clamp(1rem, 2.2vw, 1.18rem);
    line-height: 1.62;
    color: var(--text-muted);
    max-width: 56ch;
    margin-bottom: var(--space-8);
    text-wrap: pretty;
  }

  .hero-actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    width: 100%;
  }
  @media (min-width: 520px) {
    .hero-actions { width: auto; }
  }

  .btn-hero-primary,
  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0.85rem 1.35rem;
    border-radius: var(--radius-full);
    font-size: 0.98rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
    cursor: pointer;
    transition: transform 180ms var(--ease), box-shadow 180ms var(--ease), background-color 180ms var(--ease), border-color 180ms var(--ease), color 180ms var(--ease);
    will-change: transform;
  }
  .btn-hero-primary {
    background: var(--cta);
    color: var(--cta-contrast);
    border: 1px solid var(--cta);
    box-shadow: 0 8px 22px -10px color-mix(in srgb, var(--cta) 65%, transparent), var(--shadow-sm);
  }
  .btn-hero-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -10px color-mix(in srgb, var(--cta) 72%, transparent), var(--shadow-md);
    color: var(--cta-contrast);
  }
  .btn-hero-primary:active { transform: translateY(0) scale(0.98); }
  .btn-arrow { transition: transform 180ms var(--ease); }
  .btn-hero-primary:hover .btn-arrow { transform: translateX(3px); }

  .btn-hero-secondary {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }
  .btn-hero-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
    transform: translateY(-2px);
  }
  .btn-hero-secondary:active { transform: translateY(0) scale(0.98); }

  .hero-proofs {
    position: relative;
    z-index: 1;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-8);
    padding: 0;
  }
  .hero-proofs li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: -0.01em;
  }
  .hero-proofs svg { color: var(--success); flex: none; }

  .hero-tagline {
    position: relative;
    z-index: 1;
    margin-top: var(--space-8);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-muted) 72%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge-dot::after, .hero-proofs, .hero-dots { animation: none !important; }
    .hero-dots { transform: none !important; }
  }
</style>
