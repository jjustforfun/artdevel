---
import { siteConfig } from '../data/site';
import { navConfig } from '../data/nav';
import { getLocaleFromUrl, getPageKeyFromPathname, getLocalizedPath, LOCALES, useTranslations, type Locale } from '../lib/i18n';

const pathname = Astro.url.pathname;
const currentLocale: Locale = getLocaleFromUrl(pathname);
const currentPageKey = getPageKeyFromPathname(pathname);
const navItems = navConfig[currentLocale];
const t = useTranslations(currentLocale);
---

<header class="site-header">
  <div class="container header-inner">
    <a href={getLocalizedPath('home', currentLocale)} class="site-title">
      <span class="site-logo" aria-hidden="true">{siteConfig.name.charAt(0)}</span>
      {siteConfig.name}
    </a>

    <nav id="main-nav" class="main-nav" aria-label="Navigation principale">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = item.href === pathname || (item.href !== '/' && item.href !== '/en/' && item.href !== '/ru/' && pathname.startsWith(item.href));
          return (
            <li>
              <a href={item.href} class={isActive ? 'nav-link active' : 'nav-link'} aria-current={isActive ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      <!-- Sélecteur de langue (menu mobile) -->
      <div class="lang-selector lang-selector-mobile" aria-label={t('language.select')}>
        {LOCALES.map((locale) => {
          const targetPath = getLocalizedPath(currentPageKey, locale);
          const isCurrent = locale === currentLocale;
          return (
            <a
              href={targetPath}
              class={`lang-link ${isCurrent ? 'current' : ''}`}
              aria-label={`Passer en ${t(`language.${locale}`)}`}
            >
              {locale.toUpperCase()}
            </a>
          );
        })}
      </div>
    </nav>

    <div class="header-controls">
      <!-- Sélecteur de langue (desktop) -->
      <div class="lang-selector" aria-label={t('language.select')}>
        {LOCALES.map((locale) => {
          const targetPath = getLocalizedPath(currentPageKey, locale);
          const isCurrent = locale === currentLocale;
          return (
            <a
              href={targetPath}
              class={`lang-link ${isCurrent ? 'current' : ''}`}
              aria-label={`Passer en ${t(`language.${locale}`)}`}
            >
              {locale.toUpperCase()}
            </a>
          );
        })}
      </div>

      <!-- Bascule Thème Clair / Sombre -->
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label={t('theme.toggle')}>
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>

      <!-- Menu hamburger (mobile) -->
      <button
        id="nav-toggle"
        class="nav-toggle"
        type="button"
        aria-label={t('menu.open')}
        data-open-label={t('menu.open')}
        data-close-label={t('menu.close')}
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span class="nav-toggle-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  function getPreferredTheme() {
    try {
      const saved = localStorage.getItem('theme');
      if (saved) return saved;
    } catch {}
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function setTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    try {
      localStorage.setItem('theme', theme);
    } catch {}
  }

  // Applique le thème avec une transition fluide :
  // reveal circulaire depuis le bouton (View Transitions API),
  // sinon transition globale de couleur en fallback.
  function applyTheme(theme: string, origin: HTMLElement) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const startViewTransition = (document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } }).startViewTransition;

    if (reduceMotion || typeof startViewTransition !== 'function') {
      document.documentElement.classList.add('theme-changing');
      setTheme(theme);
      if (!reduceMotion) {
        window.setTimeout(() => document.documentElement.classList.remove('theme-changing'), 420);
      } else {
        document.documentElement.classList.remove('theme-changing');
      }
      return;
    }

    const rect = origin.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const maxR = Math.hypot(Math.max(cx, window.innerWidth - cx), Math.max(cy, window.innerHeight - cy));
    const root = document.documentElement;
    root.style.setProperty('--theme-reveal-x', `${cx}px`);
    root.style.setProperty('--theme-reveal-y', `${cy}px`);
    root.style.setProperty('--theme-reveal-r', `${maxR}px`);
    root.classList.add('theme-reveal');

    try {
      const vt = startViewTransition(() => setTheme(theme));
      vt?.finished?.finally(() => {
        root.classList.remove('theme-reveal');
        root.style.removeProperty('--theme-reveal-x');
        root.style.removeProperty('--theme-reveal-y');
        root.style.removeProperty('--theme-reveal-r');
      });
    } catch {
      // Transition déjà active (ex. navigation) : on bascule en transition de couleur douce
      root.classList.remove('theme-reveal');
      root.classList.add('theme-changing');
      setTheme(theme);
      window.setTimeout(() => root.classList.remove('theme-changing'), 420);
    }
  }

  function initHeader() {
    // Theme toggle
    const toggleBtn = document.getElementById('theme-toggle');
    toggleBtn?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || getPreferredTheme();
      const next = current === 'dark' ? 'light' : 'dark';
      applyTheme(next, toggleBtn);
      toggleBtn.classList.remove('theme-switching');
      void toggleBtn.offsetWidth;
      toggleBtn.classList.add('theme-switching');
    });

    // Mobile nav toggle
    const navToggle = document.getElementById('nav-toggle');
    const mainNav = document.getElementById('main-nav');
    const header = document.querySelector('.site-header');

    function setMenuState(open: boolean) {
      mainNav?.classList.toggle('open', open);
      navToggle?.setAttribute('aria-expanded', String(open));
      if (navToggle) {
        navToggle.setAttribute('aria-label', open ? navToggle.dataset.closeLabel! : navToggle.dataset.openLabel!);
      }
    }

    navToggle?.addEventListener('click', () => {
      const isOpen = mainNav?.classList.contains('open') ?? false;
      setMenuState(!isOpen);
    });

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (mainNav?.classList.contains('open') && !target.closest('.site-header')) {
        setMenuState(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setMenuState(false);
        navToggle?.focus();
      }
    });

    mainNav?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a')) {
        setMenuState(false);
      }
    });

    // Header intelligent : rétrécit au scroll, se cache en descendant, revient en remontant
    let lastY = window.scrollY;
    let scrollTicking = false;

    function updateScrollState() {
      const y = window.scrollY;
      const delta = y - lastY;
      lastY = y;
      if (!header) return;

      header.classList.toggle('is-scrolled', y > 16);

      const menuOpen = mainNav?.classList.contains('open') ?? false;
      if (menuOpen) {
        header.classList.remove('is-hidden');
        scrollTicking = false;
        return;
      }

      if (y > 320 && delta > 4) {
        header.classList.add('is-hidden');
      } else if (delta < -4 || y < 120) {
        header.classList.remove('is-hidden');
      }
      scrollTicking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!scrollTicking) {
          requestAnimationFrame(updateScrollState);
          scrollTicking = true;
        }
      },
      { passive: true }
    );
    if (window.scrollY > 0) {
      requestAnimationFrame(updateScrollState);
    }
  }

  // Initialisation une seule fois par <header> (recréé à chaque navigation)
  function onHeaderReady() {
    const header = document.querySelector('.site-header');
    if (!header || header.dataset.headerReady === '1') return;
    header.dataset.headerReady = '1';
    initHeader();
  }

  document.addEventListener('astro:page-load', onHeaderReady);
  onHeaderReady();
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background-color 300ms ease-out, border-color 300ms ease-out,
      transform 300ms var(--ease), box-shadow 300ms ease-out;
    will-change: transform;
  }

  .site-header.is-scrolled {
    background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
    box-shadow: 0 4px 20px -6px rgba(0, 0, 0, 0.12);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    gap: var(--space-4);
    transition: padding 300ms var(--ease);
  }

  .site-header.is-scrolled .header-inner {
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-brand);
    font-size: clamp(1.65rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: linear-gradient(
      135deg,
      var(--color-accent),
      color-mix(in srgb, var(--color-accent) 70%, var(--color-energy))
    );
    color: var(--color-accent-contrast);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.8rem;
    line-height: 1;
  }

  .site-title:hover {
    color: var(--color-accent);
  }

  .main-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: var(--space-6);
  }

  .nav-link {
    position: relative;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 2px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .nav-link.active::after {
    transform: scaleX(1);
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .lang-selector {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  .lang-link {
    text-decoration: none;
    color: var(--color-text-muted);
    padding: 2px 4px;
    border-radius: var(--radius-sm);
  }

  .lang-link.current {
    color: var(--color-text);
    font-weight: bold;
    background-color: var(--color-surface-hover);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    cursor: pointer;
    line-height: 0;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
  }

  .theme-toggle:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .theme-toggle.theme-switching svg {
    animation: theme-pop 350ms var(--ease);
  }

  @keyframes theme-pop {
    from {
      transform: rotate(-90deg) scale(0.5);
      opacity: 0;
    }
    to {
      transform: rotate(0deg) scale(1);
      opacity: 1;
    }
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
  }

  .icon-moon {
    display: none;
  }

  html[data-theme="dark"] .icon-sun {
    display: none;
  }

  html[data-theme="dark"] .icon-moon {
    display: block;
  }

  .lang-selector-mobile {
    display: none;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    cursor: pointer;
    line-height: 0;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .nav-toggle:hover {
    background-color: var(--color-surface-hover);
  }

  .nav-toggle-icon {
    position: relative;
    display: block;
    width: 18px;
    height: 2px;
    background-color: currentColor;
    border-radius: var(--radius-full);
  }

  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    border-radius: var(--radius-full);
    transition: transform var(--transition-fast), top var(--transition-fast);
  }

  .nav-toggle-icon::before {
    top: -6px;
  }

  .nav-toggle-icon::after {
    top: 6px;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-icon {
    background-color: transparent;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }

    .header-controls .lang-selector {
      display: none;
    }

    .main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      background-color: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      padding: var(--space-4) var(--space-6) var(--space-6);
    }

    .main-nav.open {
      display: flex;
      animation: navSlideDown 200ms var(--ease);
    }

    @keyframes navSlideDown {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .nav-list {
      flex-direction: column;
      gap: var(--space-2);
    }

    .nav-link {
      display: block;
      padding: var(--space-3) 0;
      font-size: var(--text-base);
    }

    .lang-selector-mobile {
      display: flex;
      margin-top: var(--space-4);
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-border);
    }
  }
</style>
