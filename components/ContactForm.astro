---
import { siteConfig } from '../data/site';

interface Props {
  compact?: boolean;
  locale?: 'fr' | 'en' | 'ru';
}

const { compact = false, locale = 'fr' } = Astro.props;
const copy = {
  fr: {
    name: 'Votre nom', email: 'Votre email', activity: 'Votre activité', need: 'Ce dont vous avez besoin',
    choose: 'Choisir une option', newSite: 'Créer un nouveau site', redesign: 'Refondre un site existant',
    visibility: 'Améliorer la visibilité sur Google', assistant: 'Ajouter un assistant intelligent',
    maintenance: 'Maintenir ou faire évoluer un site', other: 'Autre demande', message: 'Parlez-moi de votre projet',
    messagePlaceholder: 'Votre activité, votre objectif et ce que vous aimeriez améliorer...', submit: 'Envoyer ma demande',
    note: 'Le formulaire ouvrira votre messagerie professionnelle.',
  },
  en: {
    name: 'Your name', email: 'Your email', activity: 'Your business', need: 'What do you need?',
    choose: 'Choose an option', newSite: 'Create a new website', redesign: 'Redesign an existing website',
    visibility: 'Improve visibility on Google', assistant: 'Add an intelligent assistant',
    maintenance: 'Maintain or evolve a website', other: 'Another request', message: 'Tell me about your project',
    messagePlaceholder: 'Your business, your goal, and what you would like to improve...', submit: 'Send my request',
    note: 'The form will open your professional email client.',
  },
  ru: {
    name: 'Ваше имя', email: 'Ваш email', activity: 'Ваша деятельность', need: 'Что вам нужно?',
    choose: 'Выберите вариант', newSite: 'Создать новый сайт', redesign: 'Обновить существующий сайт',
    visibility: 'Улучшить видимость в Google', assistant: 'Добавить интеллектуального помощника',
    maintenance: 'Поддерживать или развивать сайт', other: 'Другой запрос', message: 'Расскажите о проекте',
    messagePlaceholder: 'Ваша деятельность, цель и то, что вы хотите улучшить...', submit: 'Отправить запрос',
    note: 'Форма откроет вашу рабочую почту.',
  },
}[locale];
---

<form
  class={`contact-form ${compact ? 'contact-form-compact' : ''}`}
  data-contact-form
  data-recipient={siteConfig.email}
>
  <div class="form-grid">
    <label>
      <span>{copy.name}</span>
      <input type="text" name="Nom" autocomplete="name" required placeholder="Prénom Nom" />
    </label>
    <label>
      <span>{copy.email}</span>
      <input type="email" name="Email" autocomplete="email" required placeholder="vous@entreprise.fr" />
    </label>
  </div>

  <label>
    <span>{copy.activity}</span>
    <input type="text" name="Activité" autocomplete="organization" placeholder="Entreprise, métier ou secteur" />
  </label>

  <label>
    <span>{copy.need}</span>
    <select name="Projet" required>
      <option value="" disabled selected>{copy.choose}</option>
      <option>{copy.newSite}</option>
      <option>{copy.redesign}</option>
      <option>{copy.visibility}</option>
      <option>{copy.assistant}</option>
      <option>{copy.maintenance}</option>
      <option>{copy.other}</option>
    </select>
  </label>

  <label>
    <span>{copy.message}</span>
    <textarea name="Message" rows={compact ? 3 : 4} required placeholder={copy.messagePlaceholder}></textarea>
  </label>

  <div class="form-footer">
    <button type="submit" class="form-submit" data-magnetic>
      {copy.submit} <span aria-hidden="true">↗</span>
    </button>
    <p class="form-note">{copy.note}</p>
  </div>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .contact-form-compact {
    padding: var(--space-4);
    gap: var(--space-2);
  }

  .form-grid {
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.55rem 0.7rem;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 400;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
  }

  textarea {
    resize: vertical;
    min-height: 84px;
  }

  .contact-form-compact textarea {
    min-height: 64px;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  .form-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-1);
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: 0.55rem 1rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
  }

  .form-submit:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .form-note {
    max-width: 250px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }
</style>

<script>
  function initContactForms() {
    const forms = document.querySelectorAll<HTMLFormElement>('form[data-contact-form]');
    forms.forEach((form) => {
      if (form.dataset.inited === '1') return;
      form.dataset.inited = '1';

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const recipient = form.dataset.recipient || 'contact@example.com';
        const formData = new FormData(form);
        const name = (formData.get('Nom') as string) || '';
        const email = (formData.get('Email') as string) || '';
        const activity = (formData.get('Activité') as string) || '';
        const need = (formData.get('Projet') as string) || '';
        const message = (formData.get('Message') as string) || '';

        const subject = encodeURIComponent(`Demande de contact : ${need ? need + ' — ' : ''}${name}`);
        const body = encodeURIComponent(
          `Nom : ${name}\nEmail : ${email}\nActivité / Entreprise : ${activity}\nBesoin : ${need}\n\nMessage :\n${message}`
        );

        window.location.href = `mailto:${recipient}?subject=${subject}&body=${body}`;
      });
    });
  }

  document.addEventListener('astro:page-load', initContactForms);
  initContactForms();
</script>
